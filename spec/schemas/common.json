{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "uplink v0 shared definitions",
  "$defs": {
    "decimal": {
      "description": "Non-negative decimal number encoded as a string to avoid floating-point error.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,12})?$"
    },
    "ratio": {
      "description": "Decimal string in [0, 1].",
      "type": "string",
      "pattern": "^(0(\\.[0-9]{1,6})?|1(\\.0{1,6})?)$"
    },
    "currency": {
      "description": "ISO 4217 currency code.",
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "timestamp": {
      "description": "RFC 3339 timestamp with offset.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "modelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "endpoint": {
      "type": "string",
      "enum": [
        "chat.completions",
        "responses",
        "messages",
        "embeddings",
        "images",
        "other"
      ]
    },
    "clockTime": {
      "description": "Local wall-clock time HH:MM, 24-hour.",
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "tokenLevelPrices": {
      "description": "Prices per 1,000,000 tokens for one pricing level (base or tier). Omitted cached_input / cache_write are billed at this level's input price; omitted cache_write_1h is billed at this level's cache_write price.",
      "type": "object",
      "required": [
        "input",
        "output"
      ],
      "properties": {
        "input": {
          "$ref": "#/$defs/decimal"
        },
        "cached_input": {
          "$ref": "#/$defs/decimal"
        },
        "cache_write": {
          "$ref": "#/$defs/decimal"
        },
        "cache_write_1h": {
          "$ref": "#/$defs/decimal"
        },
        "output": {
          "$ref": "#/$defs/decimal"
        }
      }
    },
    "tier": {
      "description": "Applies when context tokens are strictly greater than above_tokens.",
      "allOf": [
        {
          "$ref": "#/$defs/tokenLevelPrices"
        }
      ],
      "type": "object",
      "required": [
        "above_tokens"
      ],
      "properties": {
        "above_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "input": true,
        "cached_input": true,
        "cache_write": true,
        "cache_write_1h": true,
        "output": true
      },
      "additionalProperties": false
    },
    "tokenPrice": {
      "allOf": [
        {
          "$ref": "#/$defs/tokenLevelPrices"
        }
      ],
      "type": "object",
      "required": [
        "unit"
      ],
      "properties": {
        "unit": {
          "const": "per_1m_tokens"
        },
        "input": true,
        "cached_input": true,
        "cache_write": true,
        "cache_write_1h": true,
        "output": true,
        "basis": {
          "description": "How tiers apply. v0 defines only whole_request: the entire request is billed at the selected tier's prices.",
          "type": "string",
          "enum": [
            "whole_request"
          ],
          "default": "whole_request"
        },
        "tiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tier"
          },
          "minItems": 1
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "requestPrice": {
      "type": "object",
      "required": [
        "unit",
        "price"
      ],
      "properties": {
        "unit": {
          "const": "per_request"
        },
        "price": {
          "$ref": "#/$defs/decimal"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "customPrice": {
      "description": "Pricing that cannot be expressed in v0. Downstream sync must never apply it automatically.",
      "type": "object",
      "required": [
        "unit",
        "description"
      ],
      "properties": {
        "unit": {
          "const": "custom"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "price": {
      "oneOf": [
        {
          "$ref": "#/$defs/tokenPrice"
        },
        {
          "$ref": "#/$defs/requestPrice"
        },
        {
          "$ref": "#/$defs/customPrice"
        }
      ]
    },
    "timePricing": {
      "description": "Time-of-day multipliers. A request whose created_at, converted to timezone, falls in [start, end) of a window has its whole cost multiplied. Windows must not overlap and must not cross midnight.",
      "type": "object",
      "required": [
        "timezone",
        "windows"
      ],
      "properties": {
        "timezone": {
          "description": "IANA time zone name.",
          "type": "string",
          "minLength": 1
        },
        "weekdays_only": {
          "description": "When true, windows apply Monday to Friday only; weekends use multiplier 1.",
          "type": "boolean",
          "default": false
        },
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "start",
              "end",
              "multiplier"
            ],
            "properties": {
              "start": {
                "$ref": "#/$defs/clockTime"
              },
              "end": {
                "$ref": "#/$defs/clockTime"
              },
              "multiplier": {
                "$ref": "#/$defs/decimal"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "tokens": {
      "description": "Disjoint token buckets: no token is counted in more than one billed bucket. reasoning is an informational subset of output and is never billed separately.",
      "type": "object",
      "required": [
        "input",
        "cached_input",
        "output"
      ],
      "properties": {
        "input": {
          "description": "Uncached input tokens only.",
          "type": "integer",
          "minimum": 0
        },
        "cached_input": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write": {
          "description": "Tokens written to cache (default lifetime).",
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "cache_write_1h": {
          "description": "Tokens written to 1-hour cache.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "output": {
          "description": "Output tokens, including reasoning.",
          "type": "integer",
          "minimum": 0
        },
        "reasoning": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
