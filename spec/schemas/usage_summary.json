{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "uplink v0 usage summary (GET /uplink/v0/usage/summary)",
  "type": "object",
  "required": [
    "granularity",
    "timezone",
    "currency",
    "buckets"
  ],
  "properties": {
    "granularity": {
      "const": "day"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "$ref": "common.json#/$defs/currency"
    },
    "buckets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "model",
          "requests",
          "tokens",
          "cost"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "model": {
            "$ref": "common.json#/$defs/modelId"
          },
          "requests": {
            "type": "integer",
            "minimum": 0
          },
          "tokens": {
            "$ref": "common.json#/$defs/tokens"
          },
          "cost": {
            "$ref": "common.json#/$defs/decimal"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
