{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "uplink v0 error",
  "description": "message must not contain group, channel, account or upstream names or addresses.",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["invalid_api_key", "permission_denied", "not_found", "invalid_request", "range_too_large", "rate_limited", "unavailable", "internal"]
        },
        "message": { "type": "string", "maxLength": 500 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
